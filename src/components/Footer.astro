---
import { nav, site } from '@/data/site';
---
<footer class="bg-stone-100">
  <div class="container py-14">
    <div class="rounded-[2rem] bg-white p-8 shadow-soft md:p-10">
      <div class="grid gap-10 md:grid-cols-4">
        <div class="md:col-span-2">
          <h2 class="text-3xl font-black italic tracking-tighter">DOSU<span class="text-brand-600">OPTICAL</span></h2>
          <p class="mt-4 max-w-md text-slate-600">A premium optical store in Taipan USJ for careful eye exams, sharp prescriptions, and eyewear that feels as good as it looks.</p>
          <a class="btn-primary mt-6" href={site.whatsapp}>Book a fitting</a>
        </div>
        <div>
          <h3 class="font-black text-slate-950">Explore</h3>
          <ul class="mt-4 space-y-2 text-sm font-semibold text-slate-600">{nav.map(([label, href]) => <li><a class="hover:text-brand-600" href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <h3 class="font-black text-slate-950">Visit</h3>
          <address class="mt-4 not-italic text-sm leading-6 text-slate-600">{site.address}<br />{site.phone}</address>
          <p class="mt-4 text-sm leading-6 text-slate-600">{site.hours.map((h) => <><span>{h}</span><br /></>)}</p>
        </div>
      </div>
      <p class="mt-10 border-t border-slate-100 pt-6 text-sm text-slate-500">© {new Date().getFullYear()} DOSU Optical. Information is educational and does not replace medical diagnosis.</p>
    </div>
  </div>
</footer>
