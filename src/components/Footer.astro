---
import { nav, site } from '@/data/site';
---
<footer class="bg-stone-100">
  <div class="container py-14">
    <div class="rounded-[2rem] bg-white p-8 shadow-soft md:p-10">
      <div class="grid gap-10 md:grid-cols-4">
        <div class="md:col-span-2">
          <a class="inline-flex items-center gap-4 focus:outline-none focus:ring-4 focus:ring-brand-100" href="/" aria-label="DOSU Optical home">
            <img class="footer-brand-logo" src="/dosu-mark.svg" alt="" loading="lazy" decoding="async" />
            <span class="text-3xl font-black italic tracking-tighter text-slate-950">DOSU<span class="text-brand-600">OPTICAL</span></span>
          </a>
          <p class="mt-4 max-w-md text-slate-600">A premium optical store in Taipan USJ for careful eye exams, sharp prescriptions, and eyewear that feels as good as it looks.</p>
          <a class="btn-primary mt-6" href={site.whatsapp}>Book a fitting</a>
          <div class="mt-8">
            <h3 class="contact-detail-title">Connect with us</h3>
            <div class="mt-3 flex items-center gap-3">
              <a class="social-icon-link" href={site.social.facebook} aria-label="DOSU Eyewear on Facebook" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M22 12.06C22 6.48 17.52 2 11.94 2S2 6.48 2 12.06c0 5.03 3.66 9.2 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2V8.6h-1.26c-1.24 0-1.63.77-1.63 1.56v1.9h2.78l-.44 2.91h-2.34V22C18.34 21.26 22 17.09 22 12.06Z" />
                </svg>
              </a>
              <a class="social-icon-link" href={site.social.instagram} aria-label="DOSU Eyewear on Instagram" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.76 3.76 0 0 0 4 7.75v8.5A3.76 3.76 0 0 0 7.75 20h8.5A3.76 3.76 0 0 0 20 16.25v-8.5A3.76 3.76 0 0 0 16.25 4h-8.5Zm8.75 2.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                </svg>
              </a>
              <a class="social-icon-link" href={site.social.tiktok} aria-label="DOSU Eyewear on TikTok" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M16.6 2c.35 2.91 2 4.65 5.02 4.83v3.28a8.62 8.62 0 0 1-5-1.55v6.25c0 7.95-8.66 10.43-12.14 4.73-2.24-3.67-.87-10.1 6.32-10.36v3.46a8.2 8.2 0 0 0-1.67.41c-1.6.54-2.5 1.55-2.25 3.34.48 3.43 6.78 4.45 6.25-2.26V2h3.47Z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-black text-slate-950">Explore</h3>
          <ul class="mt-4 space-y-2 text-sm font-semibold text-slate-600">{nav.map(([label, href]) => <li><a class="hover:text-brand-600" href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <h3 class="font-black text-slate-950">Visit</h3>
          <dl class="mt-4 space-y-4 text-sm leading-6 text-slate-600">
            <div>
              <dt class="contact-detail-title">Address</dt>
              <dd>{site.address}</dd>
            </div>
            <div>
              <dt class="contact-detail-title">Phone</dt>
              <dd><a class="hover:text-brand-600" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></dd>
            </div>
            <div>
              <dt class="contact-detail-title">Business hours</dt>
              <dd>{site.hours.map((h) => <><span>{h}</span><br /></>)}</dd>
            </div>
          </dl>
        </div>
      </div>
      <p class="mt-10 border-t border-slate-100 pt-6 text-sm text-slate-500">© {new Date().getFullYear()} DOSU Optical. Information is educational and does not replace medical diagnosis.</p>
    </div>
  </div>
</footer>
