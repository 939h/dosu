---
import { nav, site } from '@/data/site';
---
<footer class="border-t border-slate-100 bg-slate-50">
  <div class="container grid gap-8 py-12 md:grid-cols-4">
    <div class="md:col-span-2"><h2 class="text-2xl font-bold">DOSU Optical</h2><p class="mt-3 max-w-md">Independent optical practice in Taipan USJ providing professional eye examinations, personalised lens advice, and long-term vision care.</p></div>
    <div><h3 class="font-semibold">Explore</h3><ul class="mt-3 space-y-2">{nav.map(([label, href]) => <li><a class="hover:text-brand-600" href={href}>{label}</a></li>)}</ul></div>
    <div><h3 class="font-semibold">Contact</h3><address class="mt-3 not-italic">{site.address}<br />{site.phone}</address><p class="mt-3">{site.hours.map((h) => <><span>{h}</span><br /></>)}</p></div>
  </div>
  <p class="container pb-8 text-sm text-slate-500">© {new Date().getFullYear()} DOSU Optical. Information is educational and does not replace medical diagnosis.</p>
</footer>
