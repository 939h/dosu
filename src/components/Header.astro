---
import { megaMenu, site } from '@/data/site';
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const isMegaActive = (label: string, href: string) => label === 'Services' ? pathname.startsWith('/services') : label === 'Learn' ? pathname.startsWith('/learn') || pathname.startsWith('/blog') : isActive(href);
const sentenceCase = (value: string) => value.charAt(0).toUpperCase() + value.slice(1).toLowerCase();
const serviceMenuImages: Record<string, string> = {
  'eye-examination': '/menu/eye-exam.svg',
  'childrens-eye-care': '/menu/child-eye-care.svg',
  'myopia-management': '/menu/myopia.svg',
  'progressive-lenses': '/menu/progressive-lenses.svg',
  'contact-lenses': '/menu/contact-lenses.svg',
  'dry-eye-consultation': '/menu/dry-eye.svg',
};
const getMenuImage = (label: string, slug: string) => label === 'Services' ? serviceMenuImages[slug] ?? '/clinic.svg' : label === 'Brands' ? '/brands/frame-slot-01.svg' : '/clinic.svg';
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950 text-white shadow-[0_18px_50px_rgba(15,23,42,.18)]">
  <div class="hidden h-8 items-center justify-center bg-slate-950/95 text-[11px] font-semibold tracking-wide text-white/70 md:flex">
    Premium eye examinations, curated frames, and lens care in Taipan USJ
  </div>
  <nav class="container flex h-[72px] items-center justify-between" aria-label="Main navigation">
    <a href="/" class="inline-flex items-center gap-3 text-lg font-black italic tracking-tighter focus:outline-none focus:ring-4 focus:ring-brand-500/40" aria-label="DOSU Optical home">
      <img class="site-brand-logo site-brand-logo--header" src="/dosu-mark.svg" alt="" loading="eager" decoding="async" />
      <span>DOSU <span class="text-brand-500">OPTICAL</span></span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {megaMenu.map((group) => (
        <div class="group/nav relative">
          <a class:list={["inline-flex rounded-full px-4 py-3 text-sm font-bold outline-none transition hover:bg-white/10 hover:text-white focus:bg-white/10 focus:text-white focus:ring-4 focus:ring-brand-500/30", isMegaActive(group.label, group.href) ? "bg-white/10 text-white shadow-[inset_0_-2px_0_#ff7a00]" : "text-white/75"]} href={group.href} aria-haspopup="true" aria-current={isMegaActive(group.label, group.href) ? "page" : undefined}>
            {group.label}
          </a>
          <div class="invisible absolute left-1/2 top-full w-[760px] -translate-x-1/2 translate-y-3 pt-4 opacity-0 transition duration-200 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100 group-focus-within/nav:visible group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100">
            <div class="grid gap-6 rounded-[2rem] border border-white/10 bg-slate-950/95 p-6 shadow-[0_30px_90px_rgba(0,0,0,.35)] ring-1 ring-white/10 backdrop-blur-xl lg:grid-cols-[.85fr_1.15fr]">
              <div class="relative min-h-[330px] overflow-hidden rounded-[1.5rem] bg-slate-900 text-white">
                <img class="absolute inset-0 h-full w-full object-cover" src={getMenuImage(group.label, group.items[0]?.slug ?? '')} alt={`${group.label} preview`} loading="lazy" decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/15 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6">
                  <p class="text-xs font-black uppercase tracking-[0.22em] text-white/75">Explore {group.label}</p>
                  <a class="mt-4 inline-flex rounded-full bg-white px-5 py-3 text-xs font-black uppercase text-slate-950 hover:bg-brand-500 hover:text-white" href={group.href}>View all</a>
                </div>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                {group.items.map((item) => {
                  const href = group.label === 'Services' ? `/services/${item.slug}` : group.label === 'Brands' ? '/brands' : item.slug === '../faq' ? '/faq' : `/learn/${item.slug}`;
                  return <a class="group/item relative min-h-[150px] overflow-hidden rounded-[1.25rem] bg-slate-900 hover:-translate-y-0.5 focus:outline-none focus:ring-4 focus:ring-brand-500/30" href={href}>
                    <img class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover/item:scale-105" src={getMenuImage(group.label, item.slug)} alt={item.title} loading="lazy" decoding="async" />
                    <span class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></span>
                    <span class="absolute bottom-4 left-4 right-4 block text-sm font-black text-white drop-shadow">{item.title}</span>
                  </a>;
                })}
              </div>
            </div>
          </div>
        </div>
      ))}
      <a class:list={["rounded-full px-4 py-3 text-sm font-bold hover:bg-white/10 hover:text-white focus:outline-none focus:ring-4 focus:ring-brand-500/30", isActive("/about") ? "bg-white/10 text-white shadow-[inset_0_-2px_0_#ff7a00]" : "text-white/75"]} href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
      <a class:list={["rounded-full px-4 py-3 text-sm font-bold hover:bg-white/10 hover:text-white focus:outline-none focus:ring-4 focus:ring-brand-500/30", isActive("/contact") ? "bg-white/10 text-white shadow-[inset_0_-2px_0_#ff7a00]" : "text-white/75"]} href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
    </div>

    <div class="hidden items-center gap-3 lg:flex">
      <a class:list={["text-sm font-bold hover:text-white", isActive("/faq") ? "text-white" : "text-white/75"]} href="/faq" aria-current={isActive("/faq") ? "page" : undefined}>FAQ</a>
      <a class="rounded-full bg-white px-5 py-2.5 text-sm font-black text-slate-950 transition hover:-translate-y-0.5 hover:bg-brand-500 hover:text-white active:translate-y-0" href={site.whatsapp}>Appointment</a>
    </div>

    <details class="group/mobile lg:hidden">
      <summary class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full text-slate-400 transition hover:text-slate-200 marker:hidden" aria-label="Open navigation menu">
        <svg class="h-8 w-8" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M6 9h20M6 16h20M6 23h20" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.25" />
        </svg>
      </summary>
      <div class="fixed inset-x-0 top-[72px] max-h-[calc(100dvh-72px)] overflow-y-auto border-t border-slate-200 bg-white p-4 text-slate-950 shadow-2xl md:top-[104px] md:max-h-[calc(100dvh-104px)]">
        <div class="space-y-3 rounded-[2rem] bg-stone-50 p-4 ring-1 ring-slate-100">
          {megaMenu.map((group) => <details class="rounded-[1.5rem] bg-white p-4 shadow-sm ring-1 ring-slate-100">
            <summary class="cursor-pointer list-none text-sm font-medium tracking-wide marker:hidden">{sentenceCase(group.label)}</summary>
            <div class="mt-4 grid gap-2">
              {group.items.map((item) => {
                const href = group.label === 'Services' ? `/services/${item.slug}` : group.label === 'Brands' ? '/brands' : item.slug === '../faq' ? '/faq' : `/learn/${item.slug}`;
                return <a class="block rounded-2xl bg-stone-50 px-4 py-3 text-sm font-normal tracking-wide text-slate-700" href={href}>{sentenceCase(item.title)}</a>;
              })}
            </div>
          </details>)}
          <a class="block rounded-[1.5rem] bg-white p-4 text-sm font-medium tracking-wide shadow-sm ring-1 ring-slate-100" href="/about">About</a>
          <a class="block rounded-[1.5rem] bg-white p-4 text-sm font-medium tracking-wide shadow-sm ring-1 ring-slate-100" href="/contact">Contact</a>
          <a class="block rounded-full bg-brand-500 px-6 py-4 text-center text-sm font-semibold uppercase text-white" href={site.whatsapp}>Appointment</a>
        </div>
      </div>
    </details>
  </nav>
</header>
