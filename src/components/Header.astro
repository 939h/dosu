---
import { megaMenu, site } from '@/data/site';
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950 text-white shadow-[0_18px_50px_rgba(15,23,42,.18)]">
  <div class="hidden h-8 items-center justify-center bg-slate-950/95 text-[11px] font-semibold tracking-wide text-white/70 md:flex">
    Premium eye examinations, curated frames, and lens care in Taipan USJ
  </div>
  <nav class="container flex h-[72px] items-center justify-between" aria-label="Main navigation">
    <a href="/" class="text-lg font-black italic tracking-tighter focus:outline-none focus:ring-4 focus:ring-brand-500/40" aria-label="DOSU Optical home">DOSU<span class="text-brand-500">OPTICAL</span></a>

    <div class="hidden items-center gap-1 lg:flex">
      {megaMenu.map((group) => (
        <div class="group/nav relative">
          <a class="inline-flex rounded-full px-4 py-3 text-sm font-bold text-white/75 outline-none transition hover:bg-white/10 hover:text-white focus:bg-white/10 focus:text-white focus:ring-4 focus:ring-brand-500/30" href={group.href} aria-haspopup="true">
            {group.label}
          </a>
          <div class="invisible absolute left-1/2 top-full w-[760px] -translate-x-1/2 translate-y-3 pt-4 opacity-0 transition duration-200 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100 group-focus-within/nav:visible group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100">
            <div class="grid gap-6 rounded-[2rem] border border-white/10 bg-slate-950/95 p-6 shadow-[0_30px_90px_rgba(0,0,0,.35)] ring-1 ring-white/10 backdrop-blur-xl lg:grid-cols-[.85fr_1.15fr]">
              <div class="orange-panel rounded-[1.5rem] p-6 text-white">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-white/70">Explore {group.label}</p>
                <h2 class="mt-4 text-3xl font-black uppercase leading-none tracking-[-0.05em] text-white">Premium guidance, clearly organised.</h2>
                <p class="mt-4 text-sm font-semibold leading-6 text-white/75">{group.description}</p>
                <a class="mt-6 inline-flex rounded-full bg-white px-5 py-3 text-xs font-black uppercase text-slate-950 hover:bg-slate-950 hover:text-white" href={group.href}>View all</a>
              </div>
              <div class="grid gap-2 sm:grid-cols-2">
                {group.items.map((item) => {
                  const href = group.label === 'Services' ? `/services/${item.slug}` : group.label === 'Eyewear' ? '/brands' : item.slug === '../faq' ? '/faq' : `/learn/${item.slug}`;
                  return <a class="rounded-[1.25rem] p-4 hover:bg-white/10 focus:bg-white/10 focus:outline-none focus:ring-4 focus:ring-brand-500/30" href={href}>
                    <span class="block text-sm font-black text-white">{item.title}</span>
                    <span class="mt-1 block text-xs font-semibold leading-5 text-white/55">{item.desc}</span>
                  </a>;
                })}
              </div>
            </div>
          </div>
        </div>
      ))}
      <a class="rounded-full px-4 py-3 text-sm font-bold text-white/75 hover:bg-white/10 hover:text-white focus:outline-none focus:ring-4 focus:ring-brand-500/30" href="/about">About</a>
      <a class="rounded-full px-4 py-3 text-sm font-bold text-white/75 hover:bg-white/10 hover:text-white focus:outline-none focus:ring-4 focus:ring-brand-500/30" href="/contact">Contact</a>
    </div>

    <div class="hidden items-center gap-3 lg:flex">
      <a class="text-sm font-bold text-white/75 hover:text-white" href="/faq">FAQ</a>
      <a class="rounded-full bg-white px-5 py-2.5 text-sm font-black text-slate-950 transition hover:-translate-y-0.5 hover:bg-brand-500 hover:text-white active:translate-y-0" href={site.whatsapp}>Appointment</a>
    </div>

    <details class="group/mobile lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-white px-4 py-2.5 text-sm font-black text-slate-950 marker:hidden">Menu</summary>
      <div class="fixed inset-x-0 top-[72px] max-h-[calc(100dvh-72px)] overflow-y-auto border-t border-white/10 bg-slate-950/98 p-4 shadow-2xl md:top-[104px] md:max-h-[calc(100dvh-104px)]">
        <div class="space-y-3 rounded-[2rem] bg-white/[.04] p-4">
          {megaMenu.map((group) => <details class="rounded-[1.5rem] bg-white/[.06] p-4">
            <summary class="cursor-pointer list-none text-2xl font-black uppercase tracking-[-0.04em] marker:hidden">{group.label}</summary>
            <div class="mt-4 grid gap-2">
              {group.items.map((item) => {
                const href = group.label === 'Services' ? `/services/${item.slug}` : group.label === 'Eyewear' ? '/brands' : item.slug === '../faq' ? '/faq' : `/learn/${item.slug}`;
                return <a class="block rounded-2xl bg-white/[.06] px-4 py-4 text-base font-bold text-white/85" href={href}>{item.title}</a>;
              })}
            </div>
          </details>)}
          <a class="block rounded-[1.5rem] bg-white/[.06] p-4 text-2xl font-black uppercase tracking-[-0.04em]" href="/about">About</a>
          <a class="block rounded-[1.5rem] bg-white/[.06] p-4 text-2xl font-black uppercase tracking-[-0.04em]" href="/contact">Contact</a>
          <a class="block rounded-full bg-brand-500 px-6 py-4 text-center text-sm font-black uppercase text-white" href={site.whatsapp}>Appointment</a>
        </div>
      </div>
    </details>
  </nav>
</header>
