<div class="intro-splash" id="intro-splash" aria-hidden="true">
  <span class="intro-splash__word">DOSU</span>
</div>

<script type="module">
  // Always show the splash when the homepage is rendered.
  // Remove the element after the animation completes so navigating away doesn't flash it.
  if (typeof window !== 'undefined') {
    const el = document.getElementById('intro-splash');
    // Timing: intro-word-sweep ~1.35s starting at .35s and the container hides at ~2.45s+. Use 3000ms to be safe.
    const removeAfterMs = 3000;
    setTimeout(() => {
      if (el) el.remove();
    }, removeAfterMs);
  }
</script>
