---
import { site } from '@/data/site';

interface FAQ {
  question: string;
  answer: string;
}

interface Section {
  heading: string;
  body: string;
}

interface Props {
  title: string;
  sections: Section[];
  faqs: FAQ[];
}

const { title, sections, faqs } = Astro.props;
---
<div class="grid gap-5">
  {sections.map((section) => (
    <section id={section.heading.toLowerCase().replaceAll(' ', '-').replace('?', '')} class="card reveal-up hover-card scroll-mt-28">
      <p class="eyebrow">{section.heading}</p>
      <h2 class="mt-3 text-3xl font-black tracking-[-0.04em]">{section.heading}</h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">{section.body}</p>
    </section>
  ))}
</div>

<section id="faq" class="mt-12 scroll-mt-28">
  <div class="accent-squiggle text-center">
    <p class="eyebrow">FAQ</p>
    <h2 class="mt-3 text-4xl font-black uppercase tracking-[-0.04em] sm:text-5xl">{title} questions</h2>
  </div>
  <div class="mt-8 space-y-4">
    {faqs.map(({ question, answer }) => (
      <details class="card group hover-card">
        <summary class="cursor-pointer list-none text-lg font-black text-slate-950">
          <span class="inline-flex w-full items-center justify-between gap-4">
            {question}
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-600 transition duration-300 group-open:rotate-45">+</span>
          </span>
        </summary>
        <p class="mt-4 leading-7 text-slate-600">{answer}</p>
      </details>
    ))}
  </div>
</section>

<div class="mt-12 rounded-[2rem] bg-slate-950 p-8 text-white shadow-soft sm:p-10">
  <p class="text-xs font-black uppercase tracking-[0.22em] text-brand-500">Next step</p>
  <h2 class="mt-3 text-3xl font-black uppercase tracking-[-0.04em] text-white">Need a personalised recommendation?</h2>
  <p class="mt-4 max-w-2xl font-semibold leading-7 text-white/65">Bring your current glasses, contact lens details if any, and notes about symptoms or daily visual tasks. DOSU Optical will explain findings in plain language.</p>
  <a class="btn-primary mt-7 bg-white text-slate-950 hover:bg-brand-500 hover:text-white" href={site.whatsapp}>Book Appointment</a>
</div>
