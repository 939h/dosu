---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppChat from '@/components/WhatsAppChat.astro';
import IntroSplash from '@/components/IntroSplash.astro';
import { site } from '@/data/site';
const { title, description, path, jsonLd = [] } = Astro.props;
const baseSchema = [
 { '@context':'https://schema.org','@type':'Organization', name: site.name, url: site.url, telephone: site.phone, address: site.address },
 { '@context':'https://schema.org','@type':'WebSite', name: site.name, url: site.url },
 ...jsonLd,
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO title={title} description={description} path={path} jsonLd={baseSchema} />
  </head>
  <body>
    {path === '/' ? <IntroSplash /> : null}
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <WhatsAppChat />
  </body>
</html>
