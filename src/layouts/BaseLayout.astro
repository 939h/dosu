---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppChat from '@/components/WhatsAppChat.astro';
import IntroSplash from '@/components/IntroSplash.astro';
import { site } from '@/data/site';
const { title, description, path, jsonLd = [] } = Astro.props;
const schemas = Array.isArray(jsonLd) ? jsonLd : (jsonLd ? [jsonLd] : []);
const baseSchema = [
 { '@context':'https://schema.org','@type':'Organization', name: site.name, url: site.url, telephone: site.phone, address: site.address, logo: new URL('/dosu-mark1.svg', site.url).toString(), image: new URL('/dosu-mark1.svg', site.url).toString() },
 { '@context':'https://schema.org','@type':'WebSite', name: site.name, url: site.url },
 ...schemas,
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO title={title} description={description} path={path} jsonLd={baseSchema} />
    <!-- Primary favicon (preferred mark) -->
    <link rel="icon" href="/favicon.ico" type="image/svg+xml">
    <!-- Existing favicons / fallbacks -->
    <link rel="icon" href="/favicon.ico" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/dosu-logo-180.png" sizes="180x180">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#111827">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#ffffff">
  </head>
  <body>
    {path === '/' ? <IntroSplash /> : null}
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <WhatsAppChat />
  </body>
</html>
