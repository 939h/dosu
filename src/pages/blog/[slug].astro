---
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  const posts = [
    ['progressive-lenses-guide', 'Progressive Lenses Explained'],
    ['myopia-malaysia', 'Why Is Myopia Increasing in Malaysia?'],
    ['eye-examination-frequency', 'How Often Should You Have an Eye Examination?'],
  ];

  return posts.map(([slug, title]) => ({
    params: { slug },
    props: { title },
  }));
}

const { title } = Astro.props;
---

<BaseLayout title={title} description={`${title}. A practical eye care article by DOSU Optical for patients in Malaysia.`} path={Astro.url.pathname}><article class="section"><div class="container max-w-3xl"><p class="eyebrow">Blog · Eye Health · 4 min read</p><h1 class="mt-3 text-5xl font-bold">{title}</h1><p class="mt-4 text-sm">Author: DOSU Optical · Published: 2026-07-29</p><p class="mt-8 text-lg">This article answers the key questions patients ask: what the topic means, why it matters, who is affected, when to get advice, and how to choose the next step.</p><h2 class="mt-10 text-3xl font-bold">Related Articles</h2><ul class="mt-4 list-disc pl-6"><li><a href="/blog/myopia-malaysia">Why Is Myopia Increasing in Malaysia?</a></li><li><a href="/blog/eye-examination-frequency">How Often Should You Have an Eye Examination?</a></li></ul><h2 class="mt-10 text-3xl font-bold">FAQ</h2><p class="mt-4">Ask DOSU Optical for personalised advice if symptoms persist or affect daily work, school, or driving.</p></div></article></BaseLayout>
