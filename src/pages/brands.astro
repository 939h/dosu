---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Lens Brands" description="Explore premium lens brands available through DOSU Optical including ZEISS, HOYA, and Essilor." path="/brands"><section class="section"><div class="container"><p class="eyebrow">Brands</p><h1 class="mt-3 text-5xl font-bold">Premium lens solutions</h1><div class="mt-10 grid gap-6 md:grid-cols-3">{['ZEISS','HOYA','Essilor'].map((b)=><article class="card"><h2 class="text-2xl font-semibold">{b}</h2><p class="mt-3">Lens options are recommended based on prescription, working distance, visual habits, and comfort needs.</p></article>)}</div></div></section></BaseLayout>
