---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/data/site';

const frameAndSunglassesBrands: [string, string][] = [
  ['Coach', '/brands/coach.svg'],
  ['GUCCI', '/brands/gucci.svg'],
  ['Brand Slot 1', '/brands/frame-slot-01.svg'],
  ['Brand Slot 2', '/brands/frame-slot-02.svg'],
  ['Brand Slot 3', '/brands/frame-slot-03.svg'],
  ['Brand Slot 4', '/brands/frame-slot-04.svg'],
  ['Brand Slot 5', '/brands/frame-slot-05.svg'],
  ['Brand Slot 6', '/brands/frame-slot-06.svg'],
  ['Brand Slot 7', '/brands/frame-slot-07.svg'],
];

const lensBrands = [
  ['ZEISS', '/brands/zeiss.svg'],
  ['STEPPER', '/brands/stepper.svg'],
  ['Nikon', '/brands/nikon.svg'],
  ['HOYA', '/brands/hoya.svg'],
  ['Essilor', '/brands/essilor.svg'],
];
---
<BaseLayout title="Brands" description="Explore frames, sunglasses, ophthalmic lenses, featured collections, and lens brands available at DOSU Optical." path="/brands">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Brands' }]} />
  <section class="section bg-white">
    <div class="container text-center">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-slate-950">Brands</p>
      <h1 class="mt-5 text-4xl font-medium uppercase tracking-[-0.03em] text-slate-950 sm:text-5xl">Eyewear and lenses</h1>
      <p class="mx-auto mt-7 max-w-4xl text-base leading-8 text-slate-700">Explore frames, sunglasses, opthalmic lenses, and featured collections in one place. Book a personalised consultation and our team will help match the right products to your lifestyle.</p>
      <a class="mt-7 inline-flex min-w-[280px] justify-center rounded-full bg-black px-8 py-3 text-sm font-medium uppercase tracking-wide text-white transition hover:bg-brand-500" href={site.whatsapp}>Book an appointment</a>

      <div class="mx-auto mt-16">
        <p class="text-lg font-medium uppercase tracking-[0.22em] text-slate-950">FRAME &amp; SUNGLASSES</p>
      </div>

      {frameAndSunglassesBrands.length > 0 ? (
        <div class="mx-auto mt-14 grid max-w-6xl grid-cols-2 items-center gap-x-12 gap-y-14 sm:grid-cols-3 lg:grid-cols-5" aria-label="Frame and sunglasses brands">
          {frameAndSunglassesBrands.map(([brand, src]) => (
            <img src={src} alt={`${brand} frame and sunglasses brand logo`} loading="lazy" decoding="async" class="mx-auto max-h-32 w-full max-w-[190px] object-contain" />
          ))}
        </div>
      ) : (
        <p class="mx-auto mt-7 max-w-3xl text-sm leading-7 text-slate-500">Frame and sunglasses brand logos will be added here.</p>
      )}

      <div class="mx-auto mt-20">
        <p class="text-lg font-medium uppercase tracking-[0.22em] text-slate-950">Opthalmic Lenses</p>
      </div>

      <div class="mx-auto mt-14 grid max-w-6xl grid-cols-2 items-center gap-x-12 gap-y-14 sm:grid-cols-3 lg:grid-cols-5" aria-label="Lens brands">
        {lensBrands.map(([brand, src]) => (
          <img src={src} alt={`${brand} lens brand logo`} loading="lazy" decoding="async" class="mx-auto max-h-32 w-full max-w-[190px] object-contain" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
