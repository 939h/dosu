---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---
<BaseLayout title="Contact DOSU Optical" description="Book an appointment, WhatsApp, call, or find DOSU Optical in Taipan USJ, Subang Jaya." path="/contact"><section class="section"><div class="container grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Contact</p><h1 class="mt-3 text-5xl font-bold">Book an appointment</h1><p class="mt-6 text-lg">Visit DOSU Optical in Taipan USJ for eye examinations, eyewear consultation, and follow-up support.</p><dl class="mt-8 space-y-4"><div><dt class="font-semibold">Address</dt><dd>{site.address}</dd></div><div><dt class="font-semibold">Phone</dt><dd>{site.phone}</dd></div><div><dt class="font-semibold">Business hours</dt><dd>{site.hours.join(' • ')}</dd></div><div><dt class="font-semibold">Parking</dt><dd>Street and commercial-area parking are available around Taipan USJ; allow extra time during peak hours.</dd></div></dl><div class="mt-8 flex gap-4"><a class="btn-primary" href={site.whatsapp}>WhatsApp</a><a class="btn-secondary" href={site.maps}>Google Maps</a></div></div><iframe title="Google Maps location for DOSU Optical Taipan USJ" class="h-[420px] w-full rounded-3xl border-0 shadow-soft" loading="lazy" src="https://www.google.com/maps?q=Taipan%20USJ%20Subang%20Jaya&output=embed"></iframe></div></section></BaseLayout>
