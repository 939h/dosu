---
import BaseLayout from '@/layouts/BaseLayout.astro';
const qs = ['Can myopia be cured?','How often should adults have an eye examination?','How often should children have their eyes checked?','Are blue light lenses necessary?','Can diabetes affect eyesight?','How long does an eye examination take?','How do progressive lenses work?','What is digital eye strain?','When should I replace my glasses?','Can contact lenses be worn every day?'];
const jsonLd = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:qs.map((q)=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:'The answer depends on age, symptoms, prescription, eye health, and daily visual demands. DOSU Optical can provide personalised guidance after assessment.'}}))};
---
<BaseLayout title="Frequently Asked Questions" description="Answers to common questions about eye examinations, myopia, blue light lenses, diabetes and eyesight, progressive lenses, and contact lenses." path="/faq" jsonLd={[jsonLd]}><section class="section"><div class="container max-w-4xl"><p class="eyebrow">FAQ</p><h1 class="mt-3 text-5xl font-bold">Eye care questions, answered directly</h1><div class="mt-10 space-y-4">{qs.map((q)=><details class="card"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3">This topic should be assessed based on your history, symptoms, and visual needs. If you are unsure, schedule a professional eye examination.</p></details>)}</div></div></section></BaseLayout>
