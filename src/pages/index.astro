---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { services, site } from '@/data/site';
const reviews = ['Clear explanation and friendly service from start to finish.', 'Professional eye examination and helpful lens recommendations.', 'Great support for children’s eyewear and after-sales adjustments.'];
---
<BaseLayout title="Professional Eye Care in Taipan USJ" description="Comprehensive eye examinations, children’s myopia management, premium prescription eyewear, and personalised vision care in Taipan USJ." path="/">
  <section class="section bg-gradient-to-b from-brand-50 to-white"><div class="container grid items-center gap-12 lg:grid-cols-2"><div><p class="eyebrow">Taipan USJ Optical Practice</p><h1 class="mt-4 text-5xl font-bold lg:text-6xl">Professional Eye Care for Every Stage of Life</h1><p class="mt-6 text-xl text-slate-600">Comprehensive eye examinations, children’s myopia management, premium prescription eyewear, and personalised vision care in Taipan USJ.</p><div class="mt-8 flex flex-wrap gap-4"><a class="btn-primary" href="/contact">Book Appointment</a><a class="btn-secondary" href={site.whatsapp}>WhatsApp Us</a></div></div><div class="rounded-[2rem] bg-white p-4 shadow-soft"><img src="/clinic.svg" alt="Bright modern optical clinic consultation area" loading="eager" class="w-full rounded-[1.5rem]" /></div></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Why choose us</p><h2 class="mt-3 text-4xl font-bold">Practical, professional vision care</h2><div class="mt-10 grid gap-5 md:grid-cols-4">{['Professional Eye Examination','Personalised Consultation','Premium Lens Solutions','Friendly After-Sales Service'].map((x) => <article class="card"><h3 class="text-xl font-semibold">{x}</h3><p class="mt-3">Clear recommendations focused on your vision needs, lifestyle, and long-term comfort.</p></article>)}</div></div></section>
  <section class="section bg-slate-50"><div class="container"><p class="eyebrow">Our services</p><h2 class="mt-3 text-4xl font-bold">Care for children, adults, and families</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{services.map((s) => <a class="card hover:-translate-y-1" href={`/services/${s.slug}`}><h3 class="text-xl font-semibold">{s.title}</h3><p class="mt-3">{s.desc}</p><span class="mt-5 inline-block font-semibold text-brand-600">Learn more →</span></a>)}</div></div></section>
  <section class="section"><div class="container grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Customer reviews</p><h2 class="mt-3 text-4xl font-bold">Trusted by local families</h2><p class="mt-4 text-lg">Google rating display and live review integration can be connected when the business profile API or approved embed is available.</p><p class="mt-6 text-3xl font-bold text-brand-600">★★★★★ 4.9/5</p></div><div class="space-y-4">{reviews.map((r) => <blockquote class="card">“{r}”</blockquote>)}</div></div></section>
  <section class="section bg-slate-50"><div class="container"><p class="eyebrow">Eye care knowledge</p><h2 class="mt-3 text-4xl font-bold">Latest educational articles</h2><div class="mt-10 grid gap-6 md:grid-cols-4">{['Why Is Myopia Increasing Among Malaysian Children?','How Often Should You Have an Eye Examination?','Progressive Lenses Explained','Digital Eye Strain Guide'].map((title) => <article class="card"><h3 class="font-semibold">{title}</h3><a class="mt-4 inline-block text-brand-600" href="/blog/progressive-lenses-guide">Read guide →</a></article>)}</div></div></section>
</BaseLayout>
