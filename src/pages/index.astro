---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';

const trustSignals = ['Professional Eye Exams', 'Reserved Parking', 'Trendy Frames', 'After Sales Care'];
const categories = [
  ['Designer Frames', 'Acetate, titanium, and lightweight daily styles.', 'FRAMES', '/home/designer-frames.svg'],
  ['Sunglasses', 'Sun-ready eyewear with prescription and lifestyle options.', 'SUN', '/home/sunglasses.svg'],
  ['Family Eye Care', 'Children, adults, and long-term prescription care.', 'CARE', '/home/family-eye-care.svg'],
];
const reviews = ['Clear explanation and friendly service from start to finish.', 'Professional eye examination and helpful lens recommendations.', 'Great support for children’s eyewear and after-sales adjustments.'];
const faqs = [
  ['How long does an eye examination take?', 'A typical eye examination takes around 10 to 20 minutes, while children, contact lens fittings, and detailed consultations may take longer.'],
  ['Do you help with children’s myopia?', 'Yes. DOSU Optical can review children’s vision and discuss evidence-informed myopia management options based on age, prescription, and lifestyle.'],
  ['Can I book before visiting?', 'Yes. Use WhatsApp to arrange an appointment, ask about eyewear availability, or confirm the best time to visit.'],
];
---
<BaseLayout title="Professional Eye Care in Taipan USJ" description="Comprehensive eye examinations, premium prescription eyewear, myopia management, and personalised optical care in Taipan USJ." path="/">
  <div class="design-shell">
    <section class="orange-panel relative min-h-[calc(100dvh-95px)] overflow-hidden px-4 py-10 text-white sm:px-8 lg:px-14">
      <div class="absolute inset-x-0 top-12 mx-auto h-[46rem] max-w-6xl rounded-full bg-black/10 blur-3xl"></div>
      <div class="relative mx-auto grid min-h-[calc(100dvh-12rem)] max-w-7xl items-center gap-10 lg:grid-cols-[.85fr_1.15fr]">
        <div class="reveal-up max-w-xl pt-8 lg:pt-0">
          <p class="text-xs font-black uppercase tracking-[0.26em] text-white/75">Taipan USJ Optical Shop</p>
          <h1 class="mt-5 text-5xl font-black uppercase leading-[.88] tracking-[-0.02em] sm:text-6xl lg:text-7xl">See sharper. Look iconic.</h1>
          <p class="mt-6 max-w-[52ch] text-lg font-semibold leading-8 text-white/80">Professional eye examinations, personalised eyewear consultation, and quality lens solutions designed for everyday life.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn-primary bg-slate-950" href="/contact">Visit us</a>
            <a class="btn-secondary border-white/30 bg-white/15 text-white backdrop-blur hover:border-white hover:text-white" href="/services/eye-examination">Book eye exam</a>
          </div>
        </div>
        <div class="relative mx-auto grid aspect-[1612/884] w-full max-w-3xl place-items-center float-slow">
          <div class="absolute inset-8 rounded-[3rem] bg-white/15 blur-3xl"></div>
          <img src="/dosu-mark.svg" alt="DOSU illustrated logo mark" loading="eager" decoding="async" class="relative h-full w-full object-contain drop-shadow-[0_35px_70px_rgba(0,0,0,.28)]" />
        </div>
      </div>
    </section>

    <section class="grid border-y border-slate-200 bg-stone-200/80 text-slate-950 md:grid-cols-4" aria-label="DOSU Optical highlights">
      {trustSignals.map((item) => <div class="border-slate-300 px-6 py-7 text-center text-sm font-black md:border-r last:border-r-0">{item}</div>)}
    </section>

    <section class="section bg-stone-100 pt-6">
      <div class="container">
        <div class="accent-squiggle text-center">
          <p class="eyebrow">Shop by Category</p>
          <h2 class="mt-3 text-4xl font-black uppercase leading-none tracking-[-0.02em] sm:text-6xl">Eyewear for every day</h2>
          <p class="mx-auto mt-4 max-w-xl font-semibold text-slate-600">Find eyewear and lens care tailored to how you work, drive, study, and show up.</p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {categories.map(([title, desc, ghost, image]) => (
            <a href="/brands" class="group relative min-h-[430px] overflow-hidden rounded-[2rem] p-8 text-white shadow-soft">
              <img src={image} alt={`${title} category preview`} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <span class="absolute inset-0 bg-gradient-to-b from-slate-950/78 via-slate-950/35 to-slate-950/82"></span>
              <span class="absolute bottom-6 right-6 text-7xl font-black tracking-[-0.08em] opacity-20">{ghost}</span>
              <h3 class="relative text-3xl font-black tracking-[-0.04em] drop-shadow">{title}</h3>
              <p class="relative mt-3 max-w-xs font-semibold leading-7 text-white/90 drop-shadow">{desc}</p>
              <span class="relative mt-7 inline-flex rounded-full bg-white px-5 py-3 text-xs font-black uppercase text-slate-950 transition group-hover:-translate-y-1 group-hover:bg-brand-500 group-hover:text-white">Shop now</span>
              <div class="absolute bottom-16 left-8 right-8 h-28 rounded-full bg-white/20 blur-2xl"></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-stone-100 pt-6">
      <div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div class="rounded-[2rem] bg-white p-8 shadow-soft"><p class="eyebrow">Why Families Trust DOSU</p><h2 class="mt-3 text-4xl font-black uppercase tracking-[-0.02em]">Clear care for parents, children, and daily wearers</h2><p class="mt-4 text-lg font-semibold text-slate-600">Friendly guidance, careful measurements, and eyewear adjustments after collection.</p></div>
        <div class="grid gap-4 md:grid-cols-3">{reviews.map((r) => <blockquote class="rounded-[2rem] bg-white p-6 font-semibold leading-7 shadow-soft">“{r}”</blockquote>)}</div>
      </div>
    </section>

    <section class="section bg-stone-100 pt-6">
      <div class="container grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
        <div class="orange-panel rounded-[2rem] p-8 text-white shadow-soft"><p class="text-sm font-black uppercase tracking-[0.22em] text-white/70">Google Reviews</p><h2 class="mt-4 text-5xl font-black tracking-[-0.05em] text-white">4.9/5</h2><p class="mt-4 font-semibold leading-7 text-white/75">Local feedback for professional service, clear explanations, and helpful eyewear support.</p></div>
        <div class="grid gap-4 md:grid-cols-3">{reviews.map((r) => <blockquote class="rounded-[2rem] bg-white p-6 font-semibold leading-7 shadow-soft">“{r}”<span class="mt-5 block text-sm font-black text-brand-600">Google review</span></blockquote>)}</div>
      </div>
    </section>

    <section class="section bg-stone-100 pt-6">
      <div class="container max-w-4xl">
        <div class="accent-squiggle text-center"><p class="eyebrow">FAQ</p><h2 class="mt-3 text-4xl font-black uppercase tracking-[-0.02em] sm:text-5xl">Quick answers before you visit</h2></div>
        <div class="mt-10 space-y-4">{faqs.map(([question, answer]) => <details class="card group"><summary class="cursor-pointer list-none text-lg font-black text-slate-950"><span class="inline-flex w-full items-center justify-between gap-4">{question}<span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-600 transition group-open:rotate-45">+</span></span></summary><p class="mt-4 leading-7 text-slate-600">{answer}</p></details>)}</div>
        <div class="mt-8 text-center"><a class="btn-secondary" href="/faq">View all FAQ</a></div>
      </div>
    </section>

    <section class="section bg-stone-100 pt-6">
      <div class="container grid gap-8 lg:grid-cols-[.9fr_1.1fr]">
        <div class="rounded-[2rem] bg-white p-8 shadow-soft"><p class="eyebrow">Map & Contact</p><h2 class="mt-3 text-4xl font-black uppercase tracking-[-0.02em]">Visit DOSU Optical in Taipan USJ</h2><dl class="mt-6 space-y-4 leading-7 text-slate-600"><div><dt class="font-black text-slate-950">Address</dt><dd>{site.address}</dd></div><div><dt class="font-black text-slate-950">Phone</dt><dd>{site.phone}</dd></div><div><dt class="font-black text-slate-950">Business hours</dt><dd>{site.hours.join(' • ')}</dd></div></dl><div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href={site.whatsapp}>WhatsApp appointment</a><a class="btn-secondary" href={site.maps}>Google Maps</a></div></div>
        <iframe title="Google Maps location for DOSU Optical Taipan USJ" class="h-[430px] w-full rounded-[2rem] border-0 shadow-soft" loading="lazy" src="https://www.google.com/maps?q=No%2049%20Jalan%20USJ%2010%2F1g%20Taipan%20Business%20Center%2047620%20Subang%20Jaya%20Selangor%20Malaysia&output=embed"></iframe>
      </div>
    </section>
  </div>
</BaseLayout>
