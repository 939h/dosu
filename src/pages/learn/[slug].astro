---
import BaseLayout from '@/layouts/BaseLayout.astro';
const topics = { myopia:'Myopia', 'digital-eye-strain':'Digital Eye Strain', 'lens-guide':'Lens Guide', 'childrens-vision':'Children’s Vision', 'eye-health':'Eye Health' };
export function getStaticPaths(){return Object.entries(topics).map(([slug,title])=>({params:{slug},props:{title}}));}
const { title } = Astro.props;
---
<BaseLayout title={`${title} Learning Centre`} description={`Educational guide to ${title.toLowerCase()} from DOSU Optical's knowledge centre.`} path={Astro.url.pathname}><section class="section"><div class="container max-w-4xl"><p class="eyebrow">Learn</p><h1 class="mt-3 text-5xl font-bold">{title}</h1><p class="mt-6 text-lg">This knowledge centre explains what {title.toLowerCase()} means, why it matters, who should pay attention, when to seek advice, and how eye care decisions are made.</p></div></section></BaseLayout>
