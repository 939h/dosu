---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceEducation from '@/components/ServiceEducation.astro';
import { services, serviceEducation } from '@/data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const education = serviceEducation[service.slug];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: education.faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<BaseLayout title={service.title} description={`${service.desc} Learn what it is, who needs it, how it works, and when to consider it at DOSU Optical in Taipan USJ.`} path={`/services/${service.slug}`} jsonLd={[jsonLd]}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/eye-examination' }, { label: service.title }]} />
  <section class="section">
    <div class="container grid gap-10 lg:grid-cols-[.78fr_.22fr]">
      <article class="max-w-4xl">
        <p class="eyebrow">Service</p>
        <h1 class="mt-3 text-5xl font-black tracking-[-0.05em] sm:text-6xl">{service.title}</h1>
        <p class="mt-6 max-w-3xl text-xl font-semibold leading-9 text-slate-600">{service.desc}</p>
        <div class="mt-10">
          <ServiceEducation title={service.title} sections={education.sections} faqs={education.faqs} />
        </div>
      </article>
      <aside class="lg:sticky lg:top-32 lg:self-start">
        <nav class="rounded-[2rem] bg-white p-5 shadow-soft" aria-label={`${service.title} page sections`}>
          <p class="px-3 text-xs font-black uppercase tracking-[0.22em] text-brand-600">On this page</p>
          <div class="mt-4 grid gap-2">
            {education.sections.map((section) => <a class="rounded-full px-3 py-2 text-sm font-black text-slate-600 hover:bg-brand-100 hover:text-brand-600" href={`#${section.heading.toLowerCase().replaceAll(' ', '-').replace('?', '')}`}>{section.heading}</a>)}
            <a class="rounded-full px-3 py-2 text-sm font-black text-slate-600 hover:bg-brand-100 hover:text-brand-600" href="#faq">FAQ</a>
          </div>
        </nav>
      </aside>
    </div>
  </section>
</BaseLayout>
